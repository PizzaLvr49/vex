@import std;

SoaErr :: pub error {
    OutOfSpace,
}

Soa :: pub fn(const T: type, const capacity: usize) -> type {
    return struct {
        macro for (T.fields) |field| {
            $(field.name + "_arr"): [capacity] $(field.type),
        }

        count: usize = 0,

        push :: fn(*self, item: T) -> SoaErr!void {
            if (self.*.count >= capacity) return SoaErr.OutOfSpace;

            macro for (T.fields) |field| {
                self.*.$(field.name + "_arr")[self.*.count] = item.$(field.name);
            }

            self.*.count += 1;
        }

        get :: fn(*self, index: usize) -> ?T {
            if (index >= self.*.count) return null;

            return T {
                macro for (T.fields) |field| {
                    .$(field.name) = self.*.$(field.name + "_arr")[index],
                }
            };
        }
    }
}

Enemy :: struct {
    id: u32,
    hp: f32,
}

EnemySoa :: Soa(Enemy, 128);

ArbitrarySoa :: Soa(struct {
    any: u32,
    random: f64,
}, 128);

main :: fn() -> !void {
    pool: EnemySoa = .{};

    one := Enemy{ .id = 1, .hp = 100.0 };
    two := Enemy{ .id = 2, .hp = 100.0 };

    try pool:push(one);
    pool:push(two) catch unreachable;
}

DrawError :: error {
    Misc,
}

render :: fn(const T: type, x: T) -> DrawError!void {
    return x:draw();
}

render_with_msg :: fn(const T: type, x: T) -> DrawError!void {
    macro if T.methods.contains("draw") else @panic
        T.name + " passed to render() but does not implement draw(): DrawError!void"
        + " - available methods: " + T.methods.join(", ");
    return x:draw();
}

reflection_example :: fn(const T: type, obj: *T) -> void {
    macro for (T.fields) |f| {
        std.log.info("{}: {}", f.name, obj.*.$(f.name));
    }
}

anydata :: struct {
    data: *void,
    type: *type,
}

const type :: struct {
    name:   string,
    size:   usize,
    fields: []field,
}

const field :: struct {
    name:   string,
    offset: usize,
    type:   *type,
}

runtime_reflection_example :: fn(obj: *anydata) -> void {
    base := obj.*.data as [*]u8;

    for (obj.*.type.*.fields) |f| {
        ptr := base + f.offset;
        data: u32 = (ptr as *u32).*;
    }
}

cast :: fn(const T: type, obj: *anydata) -> ?*T {
    if (obj.*.type != T) return null;
    return obj.*.data as *T;
}

get :: fn(const T: type, obj: *anydata, field: string) -> ?T {
    f := obj.*.type.*.fields:find(|f| f.name == field) orelse return null;
    if (f.type != T) return null;
    ptr := (obj.*.data as [*]u8 + f.offset) as *T;
    return ptr.*;
}

Example :: struct {
    x: f32,
    y: u32,
}

MyUnion :: union {
    Type1 :: struct {
        field_one: u32,
    },
    Type2 :: struct {
        another_field: f32,
    },
}

Shape :: enum {
    Circle :: struct {
        radius: f32,
    },
    Rect :: struct {
        width:  f32,
        height: f32,
    },
    Point,
}

Direction :: enum {
    North,
    South,
    East,
    West,
}

area :: fn(shape: Shape) -> f32 {
    return match shape {
        .Circle(c)  => std.math.PI * c.*.radius * c.*.radius,
        .Rect(r)    => r.*.width * r.*.height,
        .Point      => 0.0,
    };
}

describe :: fn(shape: Shape) -> void {
    match shape {
        .Circle(c)  => std.log.info("circle r={}", c.*.radius),
        .Rect(r)    => std.log.info("rect {}x{}", r.*.width, r.*.height),
        .Point      => std.log.info("point"),
    }
}

UserId :: Struct(id: u64) {
    pub fn is_valid(*self) -> bool {
        return self.*.id > 0;
    }
}